APP_NAME=phr-backend
APP_ENV=development
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

DATABASE_URL=postgres://postgres:postgres@postgres:5432/phr?sslmode=disable
DB_MAX_OPEN_CONNS=15
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_IDLE=5m
DB_CONN_MAX_LIFE=60m

JWT_SECRET=change-me
JWT_TOKEN_TTL=24h
JWT_REFRESH_TTL=336h
