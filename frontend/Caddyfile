:3000 {
    root * /usr/share/caddy

    # 启用文件服务
    file_server

    # React Router 前端路由支持
    try_files {path} /index.html

    # 可选：压缩响应（类似 nginx gzip）
    encode gzip zstd

    # 可选：缓存控制
    header Cache-Control "public, max-age=31536000, immutable"

    # 可选：为 HTML 禁用缓存
    @htmlFiles {
        path *.html
    }
    header @htmlFiles Cache-Control "no-cache"
}
