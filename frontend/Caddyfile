:3000 {
    root * /usr/share/caddy

    # 启用文件服务
    file_server

    # React Router 前端路由支持
    try_files {path} /index.html

    # 可选：压缩响应（类似 nginx gzip）
    encode gzip zstd

    # HTML 不缓存，避免部署后仍加载旧入口文件。
    @htmlFiles {
        path /
        path *.html
    }
    header @htmlFiles Cache-Control "no-cache"

    # 带 hash 的静态资源长期缓存。
    @staticFiles {
        path /assets/*
        path /vite.svg
    }
    header @staticFiles Cache-Control "public, max-age=31536000, immutable"
}
